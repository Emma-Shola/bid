DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/zaaa?retryWrites=true&w=majority"
JWT_SECRET="replace-with-a-long-random-secret"
OPENAI_API_KEY="your-openai-api-key"

# Cookie names (optional — defaults shown)
AUTH_COOKIE_NAME="zaaa_token"
AUTH_REFRESH_COOKIE_NAME="zaaa_refresh"

# Set to "true" to force secure cookies in non-localhost environments
COOKIE_SECURE="true"

# Frontend origin for CORS (required in production)
CLIENT_URL="http://localhost:5173"

# Redis — used for BullMQ job queues and pub/sub
REDIS_URL=""
REDIS_PUBSUB_CHANNEL="zaaa:realtime"

# Upstash Redis — used for rate limiting (optional; falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# S3-compatible object storage (optional — falls back to local disk, which does NOT
# persist across deploys/restarts on Railway. Set these in production.)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"

# Seed credentials (used by prisma/seed.ts only)
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""

# Server bind options (optional — defaults: 0.0.0.0:3000)
HOSTNAME="0.0.0.0"
PORT="3000"
